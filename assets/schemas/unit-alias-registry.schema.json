{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:caogong-intl-qty:unit-alias-registry.schema.json",
  "title": "Project-scoped Unit Alias Registry",
  "type": "object",
  "required": ["schema_version", "project_id", "context", "aliases"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "anyOf": [{"required": ["jurisdiction"]}, {"required": ["language"]}],
      "properties": {"jurisdiction": {"type": "string"}, "language": {"type": "string"}},
      "additionalProperties": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alias", "canonical_unit", "dimension", "approval_status", "approved_by", "approved_at", "source_document", "source_clause", "applicability"],
        "properties": {
          "alias": {"type": "string", "minLength": 1},
          "canonical_unit": {"type": "string", "minLength": 1},
          "dimension": {"enum": ["length", "area", "volume", "mass", "count", "item"]},
          "approval_status": {"const": "APPROVED"},
          "approved_by": {"type": "string", "minLength": 1},
          "approved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ].*)?$"},
          "source_document": {"type": "string", "minLength": 1},
          "source_clause": {"type": "string", "minLength": 1},
          "applicability": {
            "type": "object",
            "anyOf": [{"required": ["project_id"]}, {"required": ["jurisdiction"]}, {"required": ["language"]}],
            "properties": {"project_id": {"type": "string"}, "jurisdiction": {"type": "string"}, "language": {"type": "string"}},
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "notes": {"type": "string"}
  },
  "additionalProperties": true
}
