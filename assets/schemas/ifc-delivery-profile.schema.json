{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caogong.example/schemas/ifc-delivery-profile.schema.json",
  "title": "IDS-inspired IFC QTO delivery profile subset",
  "type": "object",
  "required": ["schema_version", "profile_id", "project_id", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "requirements": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["requirement_id", "entity_types", "min_count"],
      "properties": {
        "requirement_id": {"type": "string", "minLength": 1},
        "entity_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "min_count": {"type": "integer", "minimum": 0},
        "require_global_id": {"type": "boolean"},
        "require_name": {"type": "boolean"},
        "required_quantity_sets": {"type": "array", "items": {"type": "string"}},
        "required_quantities": {"type": "array", "items": {"type": "object", "required": ["quantity_set", "quantity_name"], "properties": {"quantity_set": {"type": "string"}, "quantity_name": {"type": "string"}, "kind": {"type": "string"}, "unit_dimension": {"type": "string"}}}}
      }
    }}
  }
}
