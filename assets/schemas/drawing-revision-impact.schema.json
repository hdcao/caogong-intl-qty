{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:caogong-intl-qty:drawing-revision-impact.schema.json",
  "title": "Drawing Revision Impact Report",
  "type": "object",
  "required": ["schema_version", "tool", "tool_version", "snapshots", "summary", "changes", "release_review", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool": {"const": "drawing_revision_diff"},
    "tool_version": {"type": "string", "minLength": 1},
    "project_id": {"type": "string"},
    "snapshots": {"type": "object", "required": ["baseline", "current", "impact_map"], "properties": {
      "baseline": {"$ref": "#/$defs/snapshot"},
      "current": {"$ref": "#/$defs/snapshot"},
      "impact_map": {"$ref": "#/$defs/snapshot"}
    }, "additionalProperties": false},
    "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "changes": {"type": "array", "items": {"type": "object", "required": ["sheet", "change_type", "impact_disposition", "quantity_impacts", "blockers"], "properties": {
      "sheet": {"type": "string", "minLength": 1},
      "change_type": {"type": "string"},
      "baseline_rev": {"type": "string"},
      "current_rev": {"type": "string"},
      "baseline_sha256": {"type": "string"},
      "current_sha256": {"type": "string"},
      "impact_disposition": {"type": "string"},
      "quantity_impacts": {"type": "array", "items": {"type": "object"}},
      "blockers": {"type": "array", "items": {"type": "string"}}
    }, "additionalProperties": true}},
    "release_review": {"type": "object", "required": ["eligible", "blockers"], "properties": {"eligible": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"snapshot": {"type": "object", "required": ["path", "sha256", "rows_read"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rows_read": {"type": "integer", "minimum": 0}, "active_sheets": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
  "additionalProperties": true
}
